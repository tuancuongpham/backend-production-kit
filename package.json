{
  "name": "backend-production-kit",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Reference code and verification tests for the backend-production-kit skills.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify:up": "docker compose -f verify/docker-compose.yml up -d --wait",
    "verify:down": "docker compose -f verify/docker-compose.yml down -v",
    "test": "node --test --test-concurrency=1 \"verify/tests/**/*.test.ts\"",
    "test:unit": "node --test verify/tests/skills/pii-redaction.test.ts verify/tests/skills/llm-gateway.test.ts verify/tests/skills/service-hardening.test.ts verify/tests/skills/sse-streaming.test.ts verify/tests/skills/llm-observability.test.ts verify/tests/skills/adr-writer.test.ts",
    "validate": "node scripts/validate-skills.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "sync:shared": "node scripts/sync-shared.mjs",
    "bench": "node bench/run.ts",
    "bench:docker": "node scripts/bench-docker.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.0.1",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "ioredis": "^5.6.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
